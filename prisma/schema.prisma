generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  role String @default("customer")

  avatar String?

  phone String?

  address String?

  memberSince String?

  loans Loan[]
}
model Book {
  id Int @id @default(autoincrement())

  title String

  author String

  isbn String? @unique

  price Float?

  category String?

  description String?

  image String

  available Boolean @default(true)

  loans Loan[]
}

model Loan {
  id Int @id @default(autoincrement())

  userId Int

  bookId Int

  createdAt DateTime @default(now())

  returnedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  book Book @relation(fields: [bookId], references: [id])
}
